{
  "name": "@virastack/form-monorepo",
  "private": true,
  "type": "module",
  "description": "ViraStack form paketleri: mask, password ve address",
  "license": "MIT",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:browser": "pnpm -r test:browser",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "size": "pnpm -r size",
    "check:package": "pnpm -r check:package",
    "check": "pnpm -r check",
    "e2e:next": "pnpm -r e2e:next",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
