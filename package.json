{
  "name": "@virastack/mask",
  "version": "2.0.0",
  "description": "Zero-config input masks for React Hook Form, with Turkish validators and server support",
  "author": {
    "name": "Ömer Gülçiçek (ViraStack)",
    "email": "iletisim@omergulcicek.com",
    "url": "https://omergulcicek.com"
  },
  "license": "MIT",
  "homepage": "https://virastack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virastack/mask.git"
  },
  "bugs": {
    "url": "https://github.com/virastack/mask/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/cjs-types.mjs",
    "dev": "tsup --watch",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "size": "size-limit",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm check:package && pnpm size",
    "prepublishOnly": "pnpm check",
    "test:coverage": "vitest run --project unit --coverage",
    "e2e:next": "node e2e/nextjs/run.mjs"
  },
  "keywords": [
    "virastack",
    "react",
    "react-hook-form",
    "mask",
    "input-mask",
    "masking",
    "formatter",
    "phone",
    "iban",
    "credit-card",
    "currency",
    "tckn",
    "vkn",
    "turkey",
    "server-actions",
    "standard-schema",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-hook-form": ">=7.55.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^6.0.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0",
    "zod": "^4.6.7"
  },
  "size-limit": [
    {
      "name": "@virastack/mask",
      "path": "dist/index.mjs",
      "import": "*",
      "limit": "9 kB",
      "ignore": [
        "react",
        "react-hook-form"
      ]
    },
    {
      "name": "@virastack/mask/server",
      "path": "dist/server.mjs",
      "import": "*",
      "limit": "7 kB"
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "commonjs"
}
