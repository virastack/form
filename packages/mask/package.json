{
  "name": "@virastack/mask",
  "version": "2.0.0",
  "description": "Zero-config input masks for React Hook Form, with Turkish validators and server support",
  "author": {
    "name": "Ömer Gülçiçek (ViraStack)",
    "email": "iletisim@omergulcicek.com",
    "url": "https://omergulcicek.com"
  },
  "license": "MIT",
  "homepage": "https://virastack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virastack/form.git",
    "directory": "packages/mask"
  },
  "bugs": {
    "url": "https://github.com/virastack/form/issues/new?labels=pkg%3Amask"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/cjs-types.mjs",
    "dev": "tsup --watch",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "size": "size-limit",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm check:package && pnpm size",
    "prepublishOnly": "pnpm check",
    "test:coverage": "vitest run --project unit --coverage",
    "e2e:next": "node e2e/nextjs/run.mjs"
  },
  "keywords": [
    "virastack",
    "react",
    "react-hook-form",
    "mask",
    "input-mask",
    "masking",
    "formatter",
    "phone",
    "iban",
    "credit-card",
    "currency",
    "tckn",
    "vkn",
    "turkey",
    "server-actions",
    "standard-schema",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-hook-form": ">=7.55.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "size-limit": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:",
    "zod": "catalog:"
  },
  "size-limit": [
    {
      "name": "@virastack/mask",
      "path": "dist/index.mjs",
      "import": "*",
      "limit": "9 kB",
      "ignore": [
        "react",
        "react-hook-form"
      ]
    },
    {
      "name": "@virastack/mask/server",
      "path": "dist/server.mjs",
      "import": "*",
      "limit": "7.5 kB"
    }
  ],
  "type": "commonjs"
}
