{
  "name": "@virastack/password",
  "version": "1.1.1",
  "description": "Accessible password hook for React: visibility, NIST-style strength, confirmation, server validation and leaked password checks",
  "author": {
    "name": "Ömer Gülçiçek (ViraStack)",
    "email": "iletisim@omergulcicek.com",
    "url": "https://omergulcicek.com"
  },
  "license": "MIT",
  "homepage": "https://virastack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virastack/form.git",
    "directory": "packages/password"
  },
  "bugs": {
    "url": "https://github.com/virastack/form/issues/new?labels=pkg%3Apassword"
  },
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./strength": {
      "import": {
        "types": "./dist/strength.d.mts",
        "default": "./dist/strength.mjs"
      },
      "require": {
        "types": "./dist/strength.d.cts",
        "default": "./dist/strength.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./pwned": {
      "import": {
        "types": "./dist/pwned.d.mts",
        "default": "./dist/pwned.mjs"
      },
      "require": {
        "types": "./dist/pwned.d.cts",
        "default": "./dist/pwned.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/cjs-types.mjs",
    "dev": "tsup --watch",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "size": "size-limit",
    "check:package": "publint --strict && attw --pack . --profile node16 && node scripts/check-dist.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm check:package && pnpm size",
    "prepublishOnly": "pnpm check",
    "e2e:next": "node e2e/nextjs/run.mjs"
  },
  "keywords": [
    "virastack",
    "react",
    "hook",
    "password",
    "password-visibility",
    "password-strength",
    "password-confirmation",
    "nist",
    "have-i-been-pwned",
    "react-hook-form",
    "server-actions",
    "accessibility",
    "a11y",
    "form-validation",
    "typescript",
    "dx"
  ],
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@virastack/mask": "^2.0.0",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "size-limit": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:",
    "zod": "catalog:"
  },
  "size-limit": [
    {
      "name": "@virastack/password",
      "path": "dist/index.mjs",
      "import": "*",
      "limit": "2.5 kB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "@virastack/password (toggle only)",
      "path": "dist/index.mjs",
      "import": "{ useViraPassword }",
      "limit": "2.5 kB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "@virastack/password/strength",
      "path": "dist/strength.mjs",
      "import": "*",
      "limit": "3 kB"
    },
    {
      "name": "@virastack/password/server",
      "path": "dist/server.mjs",
      "import": "*",
      "limit": "3 kB"
    },
    {
      "name": "@virastack/password/pwned",
      "path": "dist/pwned.mjs",
      "import": "*",
      "limit": "1 kB"
    }
  ]
}
